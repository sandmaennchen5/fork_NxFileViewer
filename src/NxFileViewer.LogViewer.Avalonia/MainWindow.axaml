<Window x:Class="NxFileViewer.LogViewer.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NxFileViewer.LogViewer"
        Title="NxFileViewer Fork · LogViewer" Icon="avares://NxFileViewerFork.LogViewer.Avalonia/Icon.ico" Width="1180" Height="820" MinWidth="760" MinHeight="520"
        Background="#F4F6FA" Foreground="#172033" FontFamily="Segoe UI" FontSize="13"
        DragDrop.AllowDrop="True">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <Style Selector="Border.log-event"><Setter Property="BorderBrush" Value="{StaticResource MutedBrush}"/></Style>
        <Style Selector="Border.log-event.info"><Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/></Style>
        <Style Selector="Border.log-event.warning">
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
            <Setter Property="Background" Value="{StaticResource WarningBackground}"/>
        </Style>
        <Style Selector="Border.log-event.error">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="Background" Value="{StaticResource ErrorBackground}"/>
        </Style>
        <Style Selector="TextBlock.level"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style>
        <Style Selector="Border.log-event.info TextBlock.level"><Setter Property="Foreground" Value="{StaticResource InfoBrush}"/></Style>
        <Style Selector="Border.log-event.warning TextBlock.log-colored"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></Style>
        <Style Selector="Border.log-event.error TextBlock.log-colored"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></Style>
    </Window.Styles>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="7"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenButton" Content="{x:Static local:UiText.Open}" Click="OpenClicked"/>
                <Button x:Name="ReloadButton" Content="{x:Static local:UiText.Reload}" Click="ReloadClicked" IsEnabled="False" Margin="0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="LogViewer" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="NxFileViewer Fork · Diagnose" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="PathText" Grid.Row="1" Text="{x:Static local:UiText.Empty}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{x:Static local:UiText.Search}" Margin="0,0,0,4"/>
                <TextBox x:Name="SearchBox" Padding="8,6" TextChanged="FilterChanged" ToolTip.Tip="{x:Static local:UiText.Search}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="{x:Static local:UiText.Minimum}" Margin="0,0,0,4"/>
                <ComboBox x:Name="LevelFilter" Padding="6,5" DisplayMemberBinding="{Binding Name}" SelectionChanged="FilterChanged"/>
            </StackPanel>
            <CheckBox x:Name="MemoryOnly" Grid.Column="2" Content="{x:Static local:UiText.Memory}" VerticalAlignment="Bottom" Margin="0,0,0,8" IsCheckedChanged="FilterChanged"/>
        </Grid>
        <ListBox x:Name="Entries" Grid.Row="3" Background="White" BorderBrush="#D6DFEB" BorderThickness="1"
                 SelectionChanged="EntrySelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ContextMenu><ContextMenu><MenuItem Header="{x:Static local:UiText.Copy}" Click="CopyClicked"/></ContextMenu></ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border IsVisible="{Binding ShowHeader}" Background="#EDF3FC" BorderBrush="#C7D7F1" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,8,0,5">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <Border Classes="log-event" Classes.info="{Binding IsInformation}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" IsVisible="{Binding !Entry.IsFileMarker}" BorderThickness="3,0,0,0" Padding="9,5" Margin="3,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{Binding Entry.Timestamp}" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" Margin="0,0,12,0"/>
                                    <TextBlock Classes="level log-colored" Text="{Binding Entry.LevelLabel}" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Classes="log-colored" Text="{Binding Entry.Message}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" Background="#D6DFEB" ResizeDirection="Rows"/>
        <DockPanel Grid.Row="5">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static local:UiText.Details}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,5"/>
            <TextBox x:Name="DetailText" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="8"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" Grid.Row="6" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</Window>
