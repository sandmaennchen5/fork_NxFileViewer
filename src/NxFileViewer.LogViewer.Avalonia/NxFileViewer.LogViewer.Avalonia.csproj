<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>4.1.1-beta3</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>NxFileViewerFork.LogViewer.Avalonia</AssemblyName>
    <RootNamespace>NxFileViewer.LogViewer</RootNamespace>
    <ApplicationIcon>../NxFileViewer/Styling/Icons/Icon.ico</ApplicationIcon>
    <AvaloniaVersion>11.3.21</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <Compile Include="../NxFileViewer.LogViewer/LogDocument.cs;../NxFileViewer.LogViewer/UiText.cs" Link="%(Filename)%(Extension)" />
    <AvaloniaResource Include="../NxFileViewer/Styling/Icons/Icon.ico" Link="Icon.ico" />
    <None Include="../../docs/LogViewer.md" Link="LogViewer.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../NxFileViewer.LogViewer/Palette.xaml" LogicalName="LogViewer.Palette" />
  </ItemGroup>
</Project>
