<Window x:Class="Emignatik.NxFileViewer.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization"
        xmlns:dragAndDrop="clr-namespace:Emignatik.NxFileViewer.Utils.MVVM.BindingExtensions.DragAndDrop"
        xmlns:customControls="clr-namespace:Emignatik.NxFileViewer.Views.CustomControls"
        xmlns:userControls="clr-namespace:Emignatik.NxFileViewer.Views.UserControls"
        xmlns:windows="clr-namespace:Emignatik.NxFileViewer.Views.Windows"
        mc:Ignorable="d"
        AllowDrop="True"
        Style="{StaticResource WindowStyle}"
        Title="{Binding Path=Title}" Height="850" Width="1400" MinHeight="600" MinWidth="1000" d:DataContext="{d:DesignInstance windows:MainWindowViewModel}"
        dragAndDrop:DropFilesBehaviorExtension.IsEnabled="True">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding Path=OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding Path=OpenLastFileCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding Path=CloseFileCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding Path=VerifyNcasIntegrityCommand}" />
        <KeyBinding Gesture="F10" Command="{Binding Path=LoadKeysCommand}" />
        <KeyBinding Gesture="F9" Command="{Binding Path=OpenTitleWebPageCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding Path=ShowRenameToolWindowCommand}" />
        <KeyBinding Gesture="Alt+S" Command="{Binding Path=ShowSettingsWindowCommand}" />
    </Window.InputBindings>

    <Grid Cursor="">
        <Grid.RowDefinitions>
            <!-- Menu -->
            <RowDefinition Height="Auto" />
            <!-- Content -->
            <RowDefinition Height="*" />
            <!-- Grid Splitter Row-->
            <RowDefinition Height="Auto" />
            <!-- Log Row -->
            <RowDefinition Height="0" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Menu}">
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Home}" Click="NavigateHome"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_File}" Click="NavigateFile"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_Title}" Click="NavigateBatch"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_WindowTitle}" Click="NavigateRename"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title}" Click="NavigateSettings"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Plugins}" Click="NavigatePlugins"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DataUpdate_Title}" Click="NavigateUpdates"/>
            </MenuItem>
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_File}">
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Open}"
                          Command="{Binding Path=OpenFileCommand}" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <Image Source="/Styling/Icons/open_16x16.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_OpenLast}"
                          Command="{Binding Path=OpenLastFileCommand}" InputGestureText="Ctrl+Shift+O">
                    <MenuItem.Icon>
                        <Image Source="/Styling/Icons/reload_last_16x16.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Close}" Command="{Binding Path=CloseFileCommand}" InputGestureText="Ctrl+Shift+C">
                    <MenuItem.Icon>
                        <Image Source="/Styling/Icons/close_16x16.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Exit}" Command="{Binding Path=ExitAppCommand}" InputGestureText="Alt+F4">
                    <MenuItem.Icon>
                        <Image Source="/Styling/Icons/exit_16x16.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Tools}">
                <MenuItem Header="NSZ">
                    <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_Compress}" Command="{Binding Nsz.CompressCommand}"/>
                    <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_Decompress}" Command="{Binding Nsz.DecompressCommand}"/>
                    <Separator/>
                    <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_Update}" Command="{Binding Nsz.UpdateCommand}"/>
                    <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_Rollback}" Command="{Binding Nsz.RollbackCommand}"/>
                    <MenuItem Header="{Binding Nsz.Status}" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_CheckIntegrity}"
                          Command="{Binding Path=VerifyNcasIntegrityCommand}" InputGestureText="F5">
                    <MenuItem.Icon>
                        <Image Source="/Styling/Icons/safe_16x16.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_CheckDirectoryIntegrity}" Command="{Binding Path=ShowBatchIntegrityWindowCommand}">
                    <MenuItem.Icon><Image Source="/Styling/Icons/safe_16x16.png" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Firmware_Title}" Command="{Binding Path=ShowBatchIntegrityWindowCommand}"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_ReloadKeys}"
                          Command="{Binding Path=LoadKeysCommand}" InputGestureText="F10">
                    <MenuItem.Icon>
                        <Image Source="/Styling/Icons/refresh_16x16.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_OpenTitleWebPage}"
                          Command="{Binding Path=OpenTitleWebPageCommand}" InputGestureText="F9">
                    <MenuItem.Icon>
                        <Image Source="/Styling/Icons/navigate_16x16.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_ShowRenameToolWindow}"
                          Command="{Binding Path=ShowRenameToolWindowCommand}" InputGestureText="F2">
                    <MenuItem.Icon>
                        <Image Source="/Styling/Icons/rename_16x16.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Update_Title}">
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DataUpdate_Title}" Click="NavigateUpdates"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Update_Check}" Command="{Binding ViewerUpdates.CheckCommand}"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Update_Install}" Command="{Binding ViewerUpdates.InstallCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding ViewerUpdates.Status}" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Options}">
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Plugins}" Click="NavigatePlugins"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DataUpdate_Title}" Click="NavigateUpdates"/>
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Settings}" Command="{Binding Path=ShowSettingsWindowCommand}" InputGestureText="Alt+S">
                    <MenuItem.Icon>
                        <Image Source="/Styling/Icons/settings_16x16.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" SelectionChanged="WorkspaceSelectionChanged">
            <TabItem x:Name="HomeTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Home}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                    <TextBlock Text="NxFileViewer" FontSize="30" Margin="0,0,0,24" HorizontalAlignment="Center"/>
                    <Border BorderBrush="{DynamicResource FontBrush.Warning}" BorderThickness="1" Padding="12" Margin="0,0,0,12"
                            Visibility="{Binding HasProdKeysProblems, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="⚠ prod.keys" Foreground="{DynamicResource FontBrush.Warning}" FontWeight="Bold"/>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,6">
                                <TextBlock Text="{Binding ProdKeysValidationSummary}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                            <WrapPanel>
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title}" Command="{Binding ShowSettingsWindowCommand}" Padding="12,5" Margin="0,0,8,0"/>
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_ReloadKeys}" Command="{Binding LoadKeysCommand}" Padding="12,5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ViewerUpdates.Status}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Update_Install}" Command="{Binding ViewerUpdates.InstallCommand}" Padding="12,5" Margin="0,0,0,12"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_File}" Click="NavigateFile" Padding="24,12" Margin="0,5"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_Title}" Click="NavigateBatch" Padding="24,12" Margin="0,5"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_WindowTitle}" Click="NavigateRename" Padding="24,12" Margin="0,5"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title}" Click="NavigateSettings" Padding="24,12" Margin="0,5"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Plugins}" Click="NavigatePlugins" Padding="24,12" Margin="0,5"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DataUpdate_Title}" Click="NavigateUpdates" Padding="24,12" Margin="0,5"/>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="FileTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_File}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ComboBox ItemsSource="{Binding ArchiveEntries}" SelectedItem="{Binding SelectedArchiveEntry}" Margin="8"
                              Visibility="{Binding HasArchiveEntries, Converter={StaticResource FalseToCollapseVisibilityConverter}}"/>
                    <Grid Grid.Row="1">
        <StackPanel  HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource WatermarkText}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DragMeAFile}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding Path=NoProdKeysLoaded, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
                <TextBlock Foreground="{StaticResource FontBrush.Warning}">⚠</TextBlock>
                <TextBlock  Margin="5,0,0,0">
                    <Hyperlink Foreground="{StaticResource FontBrush.Warning}" Command="{Binding ShowSettingsWindowCommand}">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.WarnNoProdKeysFileFound}" />
                    </Hyperlink>
                </TextBlock>
                <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_Keys}"/>
            </StackPanel>
        </StackPanel>
        <ContentControl  Content="{Binding Path=OpenedFile, Mode=TwoWay}"
                            ContentTemplateSelector="{StaticResource OpenedFileDataTemplateSelector}" />

                    </Grid>

                </Grid>
            </TabItem>
            <TabItem x:Name="BatchTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_Title}"/>
            <TabItem x:Name="RenameTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_WindowTitle}"/>
            <TabItem x:Name="SettingsTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title}"/>
            <TabItem Visibility="Collapsed" x:Name="PluginsTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Plugins}"/>
            <TabItem Visibility="Collapsed" x:Name="UpdatesTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DataUpdate_Title}"/>
        </TabControl>

        <customControls:GridSplitterEx Grid.Row="2" ResizeDirection="Rows" TriggerAnimation="{Binding Path=ErrorAnimationEnabled, Mode=TwoWay}" />
        <userControls:LoggingView Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" LogSource="{Binding LogSource, Mode=OneWay}" />

        <StatusBar Grid.Row="4">
            <!-- Status Text -->
            <StatusBarItem VerticalAlignment="Center">
                <TextBlock Text="{Binding Path=BackgroundTaskRunner.ProgressText, FallbackValue=Ready.}" ToolTip="{Binding Path=BackgroundTaskRunner.ProgressText, FallbackValue=Ready.}" />
            </StatusBarItem>

            <!-- Missing Keys Icon -->
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding Path=OpenedFile.FileOverview.MissingKeys, FallbackValue=Collapsed, Converter={StaticResource StringNullOrEmptyToCollapsedVisibilityConverter}}">
                <StatusBarItem.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowSettingsWindowCommand}" />
                </StatusBarItem.InputBindings>
                <StatusBarItem.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_CopyTextToClipboard}"
                                  Command="{Binding Path=OpenedFile.FileOverview.CopyMissingKeysCommand, FallbackValue={x:Null}}" />
                    </ContextMenu>
                </StatusBarItem.ContextMenu>
                <Label Style="{StaticResource KeyWarningIcon}"
                       ToolTip="{Binding Path=OpenedFile.FileOverview.MissingKeys, FallbackValue={x:Null}}" />
            </StatusBarItem>

            <!-- Prod.keys missing Icon -->
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding Path=NoProdKeysLoaded, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
                <StatusBarItem.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowSettingsWindowCommand}" />
                </StatusBarItem.InputBindings>
                <Label Style="{StaticResource KeyErrorIcon}"
                       ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.WarnNoProdKeysFileFound}" />
            </StatusBarItem>

            <!-- Progress Bar -->
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <customControls:ProgressBarExt Width="80" Minimum="0" Maximum="100"
                                               Visibility="{Binding Path=BackgroundTaskRunner.IsRunning, Mode=OneWay, Converter={StaticResource FalseToCollapseVisibilityConverter}}"
                                               Value="{Binding Path=BackgroundTaskRunner.ProgressValue, Mode=OneWay, FallbackValue=70}"
                                               ValueText="{Binding Path=BackgroundTaskRunner.ProgressValueText, Mode=OneWay, FallbackValue=70%}"
                                               IsIndeterminate="{Binding Path=BackgroundTaskRunner.IsIndeterminate, Mode=OneWay, FallbackValue=True}">

                    <customControls:ProgressBarExt.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding BackgroundTaskRunner.CancelCommand}" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CancelAction}" />
                        </ContextMenu>
                    </customControls:ProgressBarExt.ContextMenu>

                </customControls:ProgressBarExt>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
