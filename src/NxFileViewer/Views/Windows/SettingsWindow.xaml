<UserControl x:Class="Emignatik.NxFileViewer.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization"
        xmlns:customControls="clr-namespace:Emignatik.NxFileViewer.Views.CustomControls"
        xmlns:windows="clr-namespace:Emignatik.NxFileViewer.Views.Windows"
        xmlns:keysManagement="clr-namespace:Emignatik.NxFileViewer.Services.KeysManagement"
        xmlns:settings="clr-namespace:Emignatik.NxFileViewer.Settings"
        xmlns:bindingExtensions="clr-namespace:Emignatik.NxFileViewer.Utils.MVVM.BindingExtensions"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance windows:SettingsWindowViewModel}">

    <UserControl.Resources>
        <Style TargetType="ToolTip"><Setter Property="MaxWidth" Value="620"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="580"/></DataTemplate></Setter.Value></Setter></Style>
        <DataTemplate x:Key="KeyLocationStatusTemplate">
            <Border BorderBrush="{DynamicResource Control.Static.Border}" BorderThickness="1" Padding="8" Margin="0,4,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Location}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Keys_InUse}"
                                   Foreground="{DynamicResource FontBrush.Success}" Margin="12,0,0,0"
                                   Visibility="{Binding IsActive, Converter={StaticResource FalseToCollapseVisibilityConverter}}"/>
                    </StackPanel>
                    <DockPanel Margin="0,4,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource EditButton}" CommandParameter="{Binding FilePath}"
                                Command="{Binding DataContext.OpenKeyLocationCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_OpenKeysLocation}"/>
                        <TextBox Text="{Binding FilePath, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBoxShaded}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource FontBrush.Error}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Validation.IsValid}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FontBrush.Success}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Validation.HasWarnings}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FontBrush.Warning}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Validation.FileExists}" Value="False"><Setter Property="Foreground" Value="{DynamicResource FontBrush.Warning}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>


    <TabControl x:Name="SettingsSections">
    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_Program}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource ScrollViewer.Border.Brush}" BorderThickness="{DynamicResource ScrollViewer.Border.Thickness}">
            <ScrollViewer x:Name="ProgramSettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ProgramSettingsGroups" MaxWidth="1100" Width="{Binding ViewportWidth, ElementName=ProgramSettingsScroll}" HorizontalAlignment="Left">
                    <GroupBox x:Name="ProgramGeneralGroup" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_GroupGeneral}" Margin="8,4,8,8">
                        <StackPanel Margin="8">
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title_Language}" />
                                    <ComboBox ItemsSource="{Binding Path=AvailableLanguages}" SelectedItem="{Binding Path=SelectedLanguage}" DisplayMemberPath="DisplayName" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title_Theme}" />
                                    <ComboBox ItemsSource="{Binding Path=ThemeOptions}" SelectedValuePath="Value" SelectedValue="{Binding Path=EditedSettings.Theme}" DisplayMemberPath="DisplayName" MinWidth="100" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="ProgramVerificationGroup" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_File}" Margin="8,4,8,8">
                        <StackPanel Margin="8">
                            <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_AutoVerifyTitle}" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <CheckBox x:Name="AutoVerifyProgramCheckBox" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_AutoVerifyProgram}" IsChecked="{Binding EditedSettings.VerifyFilesOpenedInProgram}"/>
                                <customControls:TipLabel x:Name="AutoVerifyProgramTip" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_AutoVerifyProgramTip}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <CheckBox x:Name="AutoVerifyWindowsCheckBox" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_AutoVerifyWindows}" IsChecked="{Binding EditedSettings.VerifyFilesOpenedFromWindows}"/>
                                <customControls:TipLabel x:Name="AutoVerifyWindowsTip" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_AutoVerifyWindowsTip}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <CheckBox x:Name="AutoVerifyBatchDropCheckBox" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_AutoVerifyBatchDrop}" IsChecked="{Binding EditedSettings.VerifyBatchDrops}"/>
                                <customControls:TipLabel x:Name="AutoVerifyBatchDropTip" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_AutoVerifyBatchDropTip}"/>
                            </StackPanel>
                            <Separator Margin="0,10,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <CheckBox IsChecked="{Binding EditedSettings.IgnoreMissingDeltaFragments}" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_CheckBox_IgnoreMissingDeltaFragments}"/>
                                <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_IgnoreMissingDeltaFragments}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <CheckBox IsChecked="{Binding EditedSettings.OpenBlocklessCompressionNCZ}" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_CheckBox_NczOpenBlocklessCompression}"/>
                                <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_NczBlockLessCompression}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="ProgramHistoryGroup"  Margin="8,4,8,8">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="Bold" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_GroupHistory}"/>
                                <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchHistory_RetentionTip}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel Margin="8">
                            <CheckBox Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchHistory_Enable}" IsChecked="{Binding EditedSettings.EnableBatchHistory}" Margin="0,0,0,8"/>
                            <StackPanel IsEnabled="{Binding EditedSettings.EnableBatchHistory}" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchHistory_Limit}" Style="{StaticResource Title2}"/>
                                <TextBox x:Name="BatchHistoryLimitBox" Text="{Binding EditedSettings.BatchHistoryLimit, ValidatesOnExceptions=True}" Width="80" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SdBatch_Title}" Margin="8,4,8,8">
                        <StackPanel Margin="8">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="SdBatchAreasEnabled" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SdBatch_Enable}" IsChecked="{Binding EditedSettings.SdBatchSelectedAreasOnly}"/>
                                <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SdBatch_Tip}"/>
                            </StackPanel>
                            <WrapPanel IsEnabled="{Binding EditedSettings.SdBatchSelectedAreasOnly}">
                                <CheckBox Content="/switch" IsChecked="{Binding EditedSettings.SdBatchSwitch}" Margin="0,0,16,8"/>
                                <CheckBox Content="/Nintendo" IsChecked="{Binding EditedSettings.SdBatchNintendo}" Margin="0,0,16,8"/>
                                <CheckBox Content="/emuMMC" IsChecked="{Binding EditedSettings.SdBatchEmuMmc}" Margin="0,0,16,8"/>
                                <CheckBox Content="/tools" IsChecked="{Binding EditedSettings.SdBatchTools}" Margin="0,0,16,8"/>
                                <CheckBox Content="hbmenu.nro" IsChecked="{Binding EditedSettings.SdBatchHbmenu}" Margin="0,0,16,8"/>
                                <CheckBox Content="/DBIsaves" IsChecked="{Binding EditedSettings.SdBatchDbiRootSaves}" Margin="0,0,16,8"/>
                                <CheckBox Content="/dumps" IsChecked="{Binding EditedSettings.SdBatchDumps}" Margin="0,0,16,8"/>
                                <CheckBox Content="/nxdt_rw_poc" IsChecked="{Binding EditedSettings.SdBatchNxdtRwPoc}" Margin="0,0,16,8"/>
                            </WrapPanel>
                            <Expander Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SdBatch_Custom}" IsExpanded="False" IsEnabled="{Binding EditedSettings.SdBatchSelectedAreasOnly}" Margin="0,4,0,0">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBox x:Name="SdBatchCustomPaths" Text="{Binding EditedSettings.SdBatchCustomPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SdBatch_CustomTip}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="ProgramAssociationsGroup" Margin="8,4,8,8">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="Bold" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Associations_Title}"/>
                                <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Associations_Tip}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel Margin="8">
                            <Button x:Name="RegisterForkAssociations" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Associations_Register}" Command="{Binding RegisterFileAssociationsCommand}" HorizontalAlignment="Left" Padding="12,5"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="ProgramTitlesGroup" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_GroupTitleInfo}" Margin="8,4,8,8">
                        <StackPanel Margin="8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_TitlePageUrl}" />
                                <ComboBox MaxWidth="460" HorizontalAlignment="Left" x:Name="TitlePageSource" ItemsSource="{Binding TitlePageOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SelectedTitlePageSource}" />
                                <TextBox Text="{Binding EditedSettings.TitlePageUrl, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsCustomTitlePage, Converter={StaticResource FalseToCollapseVisibilityConverter}}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_TitleInfoProvider}" />
                                    <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Tinfoil_StabilityHint}"/>
                                </StackPanel>
                                <ComboBox MaxWidth="460" HorizontalAlignment="Left" ItemsSource="{Binding TitleProviderOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedTitleInfoSource}" DisplayMemberPath="DisplayName" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditedSettings.TitleInfoProvider}" Value="{x:Static settings:TitleInfoProvider.Custom}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_TitleInfoApiUrl}"/>
                                <TextBox Text="{Binding EditedSettings.TitleInfoApiUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditedSettings.TitleInfoProvider}" Value="{x:Static settings:TitleInfoProvider.GitHubTitleDb}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_TitleDbRegion}"/>
                                <ComboBox MaxWidth="460" HorizontalAlignment="Left" ItemsSource="{Binding TitleDbRegions}" SelectedItem="{Binding EditedSettings.TitleDbRegion}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="ProgramLoggingGroup" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Settings_GroupLogging}" Margin="8,4,8,8">
                        <StackPanel Margin="8">
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <StackPanel  Orientation="Horizontal">
                                        <TextBlock  Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_LogLevel}" />
                                        <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_LogLevel}"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding Path=LogLevels}" SelectedItem="{Binding Path=EditedSettings.LogLevel}" MinWidth="100" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_LogFileRetention}" />
                                    <TextBox Text="{Binding EditedSettings.LogFileRetentionCount, ValidatesOnExceptions=True}" Width="80" HorizontalAlignment="Left" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Reset}" Command="{Binding Path=ResetSettingsCommand}" Style="{StaticResource OkCancelButton}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Apply}" Command="{Binding Path=ApplySettingsCommand}" Style="{StaticResource OkCancelButton}" />
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Cancel}" Command="{Binding Path=CancelSettingsCommand}" Style="{StaticResource OkCancelButton}"/>
            </StackPanel>
        </Grid>


    </Grid>
    </TabItem>
    <TabItem x:Name="KeysSettingsTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_GroupBoxKeys}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_GroupBoxKeys}" Style="{StaticResource Title1}"/>
                                <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_Keys}"/>
                            </StackPanel>
                        </GroupBox.Header>


                        <StackPanel Orientation="Vertical" DockPanel.Dock="Top">
                            <WrapPanel Margin="0,6,0,10">
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Keys_CopyToSwitch}" Command="{Binding CopyKeysToSwitchCommand}" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Keys_CopyToSwitchHelp}" Padding="12,5" Margin="0,0,8,8"/>
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Keys_DownloadAll}" Command="{Binding DownloadKeysCommand}" Padding="12,5" Margin="0,0,8,8"/>
                                <StackPanel Margin="8,0,0,8">
                            <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Keys_DownloadHost}"/>
                            <TextBox Text="{Binding EditedSettings.KeysDownloadHost, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left"
                                     ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Keys_DownloadHostTip}" Margin="0"/>

                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                            <CheckBox IsChecked="{Binding EditedSettings.AlwaysReloadKeysBeforeOpen}" Margin="0,0,20,0"
                                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_CheckBox_AlwaysReloadKeysBeforeOpen}" />
                            <CheckBox IsChecked="{Binding EditedSettings.InjectTicketKeys}" Margin="0,0,20,0"
                                      Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_CheckBox_InjectTicketKeys}" />
                            <CheckBox IsChecked="{Binding EditedSettings.SaveTicketKeys}" IsEnabled="{Binding EditedSettings.InjectTicketKeys}" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Keys_SaveTicketKeys}"/>
                            </WrapPanel>


                            <GroupBox x:Name="ProdKeysSettingsGroup">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static keysManagement:IKeySetProviderService.DEFAULT_PROD_KEYS_FILE_NAME}" Style="{StaticResource Title1}"/>
                                        <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_ProdKeys}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ProdKeyLocations}" ItemTemplate="{StaticResource KeyLocationStatusTemplate}" Margin="0,6,0,8"/>
                                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title_KeysCustomFilePath}" />
                                    <DockPanel LastChildFill="true">
                                        <Button Command="{Binding Path=BrowseProdKeysCommand}" Style="{StaticResource BrowseButton}" DockPanel.Dock="Right"
                                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_BrowseKeys}"/>
                                        <TextBox Text="{Binding Path=EditedSettings.ProdKeysFilePath}" HorizontalAlignment="Stretch" />
                                    </DockPanel>

                                    <TextBlock  Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title_KeysDownloadUrl}" />
                                    <TextBox Text="{Binding EditedSettings.ProdKeysDownloadUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Keys_DownloadHostTip}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="TitleKeysSettingsGroup">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static keysManagement:IKeySetProviderService.DEFAULT_TITLE_KEYS_FILE_NAME}" Style="{StaticResource Title1}"/>
                                        <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_TitleKeys}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>

                                    <ItemsControl ItemsSource="{Binding TitleKeyLocations}" ItemTemplate="{StaticResource KeyLocationStatusTemplate}" Margin="0,6,0,8"/>
                                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title_KeysCustomFilePath}" />
                                    <DockPanel LastChildFill="True">
                                        <Button Command="{Binding Path=BrowseTitleKeysCommand}" Style="{StaticResource BrowseButton}" DockPanel.Dock="Right"
                                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_ToolTip_BrowseKeys}"/>
                                        <TextBox Text="{Binding Path=EditedSettings.TitleKeysFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock  Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Title_KeysDownloadUrl}" />
                                    <TextBox Text="{Binding EditedSettings.TitleKeysDownloadUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Keys_DownloadHostTip}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

            </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Reset}" Command="{Binding Path=ResetSettingsCommand}" Style="{StaticResource OkCancelButton}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Apply}" Command="{Binding Path=ApplySettingsCommand}" Style="{StaticResource OkCancelButton}" />
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Cancel}" Command="{Binding Path=CancelSettingsCommand}" Style="{StaticResource OkCancelButton}"/>
            </StackPanel>
        </Grid>
        </Grid>
    </TabItem>
    <TabItem x:Name="NamingSettingsTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_GroupBoxNamingSettings}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">                <GroupBox Grid.Row="0" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_GroupBoxNamingSettings}">
                    <StackPanel >

                        <GroupBox>
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_Patterns}" Style="{StaticResource Title1}"/>
                                    <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_ToolTip_Patterns}"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_ApplicationPattern}" Style="{StaticResource Title2}" />
                        <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Path=EditedSettings.RenamingOptions.ApplicationPattern}" bindingExtensions:TextBoxExtension.FlushOnEnterKeyPressed ="True" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        
                                        <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_ToolTip_BasePattern}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_PatchPattern}" Style="{StaticResource Title2}" />
                        <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Path=EditedSettings.RenamingOptions.PatchPattern}" bindingExtensions:TextBoxExtension.FlushOnEnterKeyPressed ="True" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        
                                        <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_ToolTip_PatchPattern}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_AddonPattern}" Style="{StaticResource Title2}" />
                        <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Path=EditedSettings.RenamingOptions.AddonPattern}" bindingExtensions:TextBoxExtension.FlushOnEnterKeyPressed ="True" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        
                                        <customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_ToolTip_AddonPattern}"/>
                                    </StackPanel>

                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox>
                            <GroupBox.Header>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_Miscellaneous}" Style="{StaticResource Title1}"/>
                            </GroupBox.Header>
                            <StackPanel>
                        <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="2" />
                                        <RowDefinition />
                                        <RowDefinition Height="2" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>


                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_InvalidWindowsCharReplacement}" Style="{StaticResource Title2}" Margin="0" HorizontalAlignment="Right"/>
                                    <TextBox Grid.Row="0" Grid.Column="2"
                                             Text="{Binding Path=EditedSettings.RenamingOptions.InvalidFileNameCharsReplacement}"
                                             MinWidth="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_ReplaceWhiteSpaceChars}" Style="{StaticResource Title2}" Margin="0" HorizontalAlignment="Right"/>
                                    <CheckBox Grid.Row="2" Grid.Column="2" x:Name="ReplaceWhiteSpacesCheckBox"
                                              IsChecked="{Binding Path=EditedSettings.RenamingOptions.ReplaceWhiteSpaceChars}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.RenamingTool_ReplaceWhiteSpaceCharsWith}" Margin="0" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource Title2}" TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ReplaceWhiteSpacesCheckBox}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Grid.Row="4" Grid.Column="2" MinWidth="20" VerticalAlignment="Center" Text="{Binding Path=EditedSettings.RenamingOptions.WhiteSpaceCharsReplacement}" HorizontalAlignment="Left">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ReplaceWhiteSpacesCheckBox}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </GroupBox></ScrollViewer>
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Reset}" Command="{Binding Path=ResetSettingsCommand}" Style="{StaticResource OkCancelButton}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Apply}" Command="{Binding Path=ApplySettingsCommand}" Style="{StaticResource OkCancelButton}" />
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Cancel}" Command="{Binding Path=CancelSettingsCommand}" Style="{StaticResource OkCancelButton}"/>
            </StackPanel>
        </Grid>
        </Grid>
    </TabItem>
    <TabItem x:Name="UpdatesSettingsTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DataUpdate_Title}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <GroupBox Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Update_Title}">
                        <StackPanel Margin="6">
                            <CheckBox Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Update_Auto}" IsChecked="{Binding EditedSettings.CheckViewerUpdatesOnStartup}"/>
                            <CheckBox Margin="0,8,0,0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Update_IncludePrereleases}" IsChecked="{Binding EditedSettings.IncludeViewerPrereleases}"/>

                        </StackPanel>
                    </GroupBox>
            <ContentControl x:Name="SettingsUpdatesContent" Grid.Row="1"/>
            <Grid Grid.Row="2" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Reset}" Command="{Binding Path=ResetSettingsCommand}" Style="{StaticResource OkCancelButton}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Apply}" Command="{Binding Path=ApplySettingsCommand}" Style="{StaticResource OkCancelButton}" />
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Cancel}" Command="{Binding Path=CancelSettingsCommand}" Style="{StaticResource OkCancelButton}"/>
            </StackPanel>
        </Grid>
        </Grid>
    </TabItem>
    <TabItem x:Name="PluginsSettingsTab" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Workspace_Plugins}">
        <ContentControl x:Name="SettingsPluginsContent"/>
    </TabItem>
    </TabControl>
</UserControl>
