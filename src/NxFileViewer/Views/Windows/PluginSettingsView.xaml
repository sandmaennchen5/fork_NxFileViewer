<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Emignatik.NxFileViewer.Views.Windows.PluginSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization" xmlns:app="clr-namespace:Emignatik.NxFileViewer" xmlns:settings="clr-namespace:Emignatik.NxFileViewer.Settings">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TabControl x:Name="PluginSections">
      <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Plugin_General}" x:Name="GeneralPluginTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <GroupBox Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.PluginLog_Title}" Margin="0,0,0,12">
              <StackPanel Margin="6">
                <TextBlock TextWrapping="Wrap" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.PluginLog_Tip}" />
                <TextBlock Text="nicoboss/nsz" Margin="0,6,0,2" />
                <ComboBox ItemsSource="{Binding PluginLogLevels}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.NszLogLevel}" />
                <TextBlock Text="NxNandManager" Margin="0,6,0,2" />
                <ComboBox ItemsSource="{Binding PluginLogLevels}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.NandLogLevel}" />
                <TextBlock Text="MTP" Margin="0,6,0,2" />
                <ComboBox ItemsSource="{Binding PluginLogLevels}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.MtpLogLevel}" />
                <TextBlock Text="NSC_BUILDER / nscb_rust" Margin="0,6,0,2" />
                <ComboBox ItemsSource="{Binding PluginLogLevels}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.PackageLogLevel}" />
              </StackPanel>
            </GroupBox>
            <GroupBox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Output_Defaults}" Margin="0,12,0,0">
              <StackPanel Margin="8">
                <TextBlock Margin="0,6,0,4" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Output_Merge}" />
                <ComboBox ItemsSource="{Binding OutputLocations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.MergeOutputLocation}" />
                <TextBlock Margin="0,6,0,4" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Output_Split}" />
                <ComboBox ItemsSource="{Binding OutputLocations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.SplitOutputLocation}" />
                <TextBlock Margin="0,6,0,4" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Output_Compression}" />
                <ComboBox ItemsSource="{Binding OutputLocations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.CompressionOutputLocation}" />
                <TextBlock Margin="0,6,0,4" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Output_Decompression}" />
                <ComboBox ItemsSource="{Binding OutputLocations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.DecompressionOutputLocation}" />
                <TextBlock Margin="0,10,0,4" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Output_Custom}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseOutputDirectoryCommand}" Padding="8,2" Margin="6,0,0,0" />
                  <TextBox Text="{Binding EditedSettings.CustomOutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Plugin_Compression}" x:Name="CompressionPluginTab" Visibility="{Binding Source={x:Static app:App.Features}, Path=NszPluginActive, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <GroupBox Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Plugin_Compression}">
              <StackPanel Margin="6">
                <TextBlock TextWrapping="Wrap" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_SettingsTip}" />
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseNszCommand}" Padding="8,2" />
                  <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Plugin_Install}" Visibility="{Binding ShowNszInstall, Converter={StaticResource FalseToCollapseVisibilityConverter}}" Command="{Binding Nsz.UpdateCommand}" Padding="8,2" Margin="4,0" />
                  <TextBox Text="{Binding EditedSettings.NszExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_Engine}" />
                <ComboBox x:Name="NszEngineSelector" ItemsSource="{Binding NszEngines}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.NszCompressionEngine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_RustPath}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseRustPackageCommand}" Padding="8,2" />
                  <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Plugin_Install}" Command="{Binding DownloadRustPackageCommand}" Padding="8,2" Margin="4,0" Visibility="{Binding ShowRustInstall, Converter={StaticResource FalseToCollapseVisibilityConverter}}" />
                  <TextBox Text="{Binding EditedSettings.RustPackageExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <StackPanel>
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding EditedSettings.NszCompressionEngine}" Value="{x:Static settings:NszCompressionEngine.Rust}">
                          <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Margin="0,10,0,0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_Mode}" />
                  <ComboBox ItemsSource="{Binding NszModeOptions}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" SelectedValue="{Binding EditedSettings.NszCompressionMode}" />
                  <StackPanel Margin="0,6,0,0">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding EditedSettings.NszCompressionMode}" Value="{x:Static settings:NszCompressionMode.Block}">
                            <Setter Property="IsEnabled" Value="True" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_BlockSize}" />
                    <ComboBox ItemsSource="{Binding NszBlockSizeOptions}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" SelectedValue="{Binding EditedSettings.NszBlockSizeExponent}" />
                  </StackPanel>
                  <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_ModeTip}" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nsz_Level}" />
                <TextBox Text="{Binding EditedSettings.NszCompressionLevel, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </GroupBox>
            <GroupBox x:Name="RustDesktopPluginGroup" Header="NSCB Desktop · nscb_rust GUI" Visibility="{Binding Desktop.IsEnabled, Converter={StaticResource FalseToCollapseVisibilityConverter}}" Margin="0,0,0,12">
              <StackPanel Margin="10">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseDesktopCommand}" Padding="8,2" />
                  <TextBox Text="{Binding EditedSettings.RustDesktopExecutablePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                </DockPanel>
                <TextBlock Text="{Binding Desktop.Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <WrapPanel>
                  <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Plugin_Install}" Command="{Binding Desktop.InstallCommand}" Padding="12,5" Margin="0,0,8,0" Visibility="{Binding ShowDesktopInstall, Converter={StaticResource FalseToCollapseVisibilityConverter}}" />
                  <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Home_LaunchExternal}" Visibility="{Binding Desktop.IsGuiEnabled, Converter={StaticResource FalseToCollapseVisibilityConverter}}" Command="{Binding Desktop.OpenGuiCommand}" Padding="12,5" />
                </WrapPanel>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_Title}" x:Name="PackagePluginTab" Visibility="{Binding Source={x:Static app:App.Features}, Path=PackageOperationsActive, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <GroupBox x:Name="PackageOperationsGroup" Visibility="{Binding Source={x:Static app:App.Features}, Path=PackageOperationsActive, Converter={StaticResource FalseToCollapseVisibilityConverter}}" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_Title}" Margin="0,0,0,12">
              <StackPanel Margin="6">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_Engine}" />
                <ComboBox x:Name="PackageEngineSelector" ItemsSource="{Binding PackageEngines}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding EditedSettings.PackageEngine}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_RustPath}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseRustPackageCommand}" Padding="8,2" />
                  <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Plugin_Install}" Command="{Binding DownloadRustPackageCommand}" Padding="8,2" Margin="4,0" Visibility="{Binding ShowRustInstall, Converter={StaticResource FalseToCollapseVisibilityConverter}}" />
                  <TextBox Text="{Binding EditedSettings.RustPackageExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Margin="0,8,0,0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_KronosPath}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseKronosPackageCommand}" Padding="8,2" />
                  <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Plugin_Install}" Command="{Binding DownloadKronosPackageCommand}" Padding="8,2" Margin="4,0" Visibility="{Binding ShowKronosInstall, Converter={StaticResource FalseToCollapseVisibilityConverter}}" />
                  <TextBox Text="{Binding EditedSettings.KronosPackageDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <Button HorizontalAlignment="Left" Visibility="{Binding KronosGui.IsGuiEnabled, Converter={StaticResource FalseToCollapseVisibilityConverter}}" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Home_LaunchExternal}" Command="{Binding KronosGui.OpenGuiCommand}" Padding="12,5" Margin="0,8,0,0" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_Tip}" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Packages.Status}" />
                <WrapPanel Margin="0,8,0,0">
                  <Button Margin="0,0,6,6" Padding="8,4" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_MergeNsp}" Command="{Binding Packages.MergeNspCommand}" />
                  <Button Margin="0,0,6,6" Padding="8,4" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_MergeXci}" Command="{Binding Packages.MergeXciCommand}" />
                  <Button Margin="0,0,6,6" Padding="8,4" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_ConvertNsp}" Command="{Binding Packages.ConvertNspCommand}" />
                  <Button Margin="0,0,6,6" Padding="8,4" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_ConvertXci}" Command="{Binding Packages.ConvertXciCommand}" />
                  <Button Margin="0,0,6,6" Padding="8,4" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Package_Split}" Command="{Binding Packages.SplitCommand}" />
                </WrapPanel>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="NxNandManager" x:Name="NandPluginTab" Visibility="{Binding Source={x:Static app:App.Features}, Path=NandPluginActive, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10">
            <GroupBox Header="NxNandManager" Margin="0,0,0,12">
              <StackPanel Margin="6">
                <TextBlock TextWrapping="Wrap" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_SettingsTip}" />
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseNandCommand}" Padding="8,2" />
                  <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Plugin_Install}" Visibility="{Binding ShowNandInstall, Converter={StaticResource FalseToCollapseVisibilityConverter}}" Command="{Binding Nand.UpdateCommand}" Padding="8,2" Margin="4,0" />
                  <TextBox Text="{Binding EditedSettings.NandExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_BisKeys}" Margin="0,8,0,0" />
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseBisKeysCommand}" Padding="8,2" />
                  <TextBox Text="{Binding EditedSettings.NandBisKeysPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="1" Margin="0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Reset}" Command="{Binding Path=ResetSettingsCommand}" Style="{StaticResource OkCancelButton}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Apply}" Command="{Binding Path=ApplySettingsCommand}" Style="{StaticResource OkCancelButton}" />
        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.SettingsView_Button_Cancel}" Command="{Binding Path=CancelSettingsCommand}" Style="{StaticResource OkCancelButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>