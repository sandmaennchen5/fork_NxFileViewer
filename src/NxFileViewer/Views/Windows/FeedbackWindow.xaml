<Window x:Class="Emignatik.NxFileViewer.Views.Windows.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Emignatik.NxFileViewer.Views.UserControls"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowStyle}" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <TextBlock x:Name="Notice" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <controls:SupportIdentityView/>
        <Label x:Name="DisplayNameLabel" Target="{Binding ElementName=DisplayName}"/>
        <TextBox x:Name="DisplayName" MaxLength="40"/>
        <TextBlock x:Name="DisplayNameHint" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <Label x:Name="TitleLabel" Target="{Binding ElementName=IssueTitle}"/>
        <TextBox x:Name="IssueTitle" MaxLength="160"/>
        <Label x:Name="DescriptionLabel" Target="{Binding ElementName=Description}"/>
        <TextBox x:Name="Description" Height="160" MaxLength="6000" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <CheckBox x:Name="PrivateLog" Margin="0,12,0,0"/>
        <TextBlock x:Name="PrivateLogHint" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <CheckBox x:Name="IncludeLog" Margin="0,12,0,0" Click="IncludeLog_Click"/>
        <StackPanel x:Name="LogPreview" Visibility="Collapsed" Margin="0,8,0,0">
            <Label x:Name="LogPreviewLabel" Target="{Binding ElementName=LogExcerpt}"/>
            <TextBox x:Name="LogExcerpt" Height="108" MaxLength="4096" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <Button x:Name="WithoutGitHub" Click="WithoutGitHub_Click" HorizontalAlignment="Left" Padding="9,4" Margin="0,14,0,0"/>
        <TextBlock x:Name="GitHubAccountDescription" TextWrapping="Wrap" Margin="0,32,0,0"/>
        <TextBlock x:Name="GitHubUser" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <WrapPanel Margin="0,8,0,0">
            <Button x:Name="SignInGitHub" Click="SignInGitHub_Click" Padding="9,4" Margin="0,0,8,0"/>
            <Button x:Name="WithGitHub" IsEnabled="False" Click="WithGitHub_Click" Padding="9,4"/>
        </WrapPanel>
        <TextBlock x:Name="GitHubStatus" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="IssueLink" Visibility="Collapsed" HorizontalAlignment="Left" Click="IssueLink_Click"/>
    </StackPanel>
    </ScrollViewer>
</Window>
