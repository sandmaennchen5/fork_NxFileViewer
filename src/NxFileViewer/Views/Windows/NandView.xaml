<UserControl x:Class="Emignatik.NxFileViewer.Views.Windows.NandView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Emignatik.NxFileViewer.Views.Windows"
 xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Tip}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Open}" Command="{Binding OpenCommand}" Padding="12,5" Margin="0,0,12,0" Visibility="{Binding IsStandalone, Converter={StaticResource FalseToCollapseVisibilityConverter}}"/>
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Info}" Command="{Binding ReadInformationCommand}" Padding="12,5" Margin="0,0,12,0"/>
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_OpenDrive}" Command="{Binding OpenDriveCommand}" Padding="12,5" Margin="0,0,12,0"/>
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Explorer}" Command="{Binding BrowseExplorerCommand}" Padding="12,5" Margin="0,0,12,0"/>
   <ComboBox ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition}" MinWidth="210" Margin="0,0,12,0" IsEnabled="{Binding Runner.IsRunning, Converter={StaticResource BoolInverterConverter}}"/>
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Export}" Command="{Binding ExportCommand}" Padding="12,5" Margin="0,0,12,0"/>
   <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CancelAction}" Command="{Binding Runner.CancelCommand}" Padding="12,5"/>
  </WrapPanel>
  <TextBlock Grid.Row="2" Text="{Binding Source}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TabControl Grid.Row="3" SelectedIndex="{Binding ExplorerTabIndex, Mode=TwoWay}">
   <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Info}">
    <TextBox Text="{Binding Information, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
   </TabItem>
   <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Explorer}">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel>
      <ComboBox ItemsSource="{Binding ExplorerPartitions}" DisplayMemberPath="Name" SelectedItem="{Binding ExplorerPartition}" MinWidth="160" Margin="0,0,8,8" IsEnabled="{Binding Runner.IsRunning, Converter={StaticResource BoolInverterConverter}}"/>
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_Explorer}" Command="{Binding BrowseExplorerCommand}" Padding="10,4" Margin="0,0,8,8"/>
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_OpenSave}" Command="{Binding OpenSaveCommand}" Padding="10,4" Margin="0,0,8,8"/>
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_LeaveSave}" Command="{Binding LeaveSaveCommand}" Padding="10,4" Margin="0,0,8,8"/>
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_ExportSave}" Command="{Binding ExportSaveCommand}" Padding="10,4" Margin="0,0,8,8"/>
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_ExplorerUp}" Command="{Binding UpExplorerCommand}" Padding="10,4" Margin="0,0,8,8"/>
      <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_ExportFile}" Command="{Binding ExportExplorerCommand}" Padding="10,4" Margin="0,0,8,8"/>
     </WrapPanel>
     <TextBox Grid.Row="1" Text="{Binding ExplorerDisplayPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8"/>
     <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TreeView ItemsSource="{Binding ExplorerFolders}" SelectedItemChanged="SelectExplorerFolder">
       <TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type local:NandExplorerFolder}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
      </TreeView>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
     <DataGrid Grid.Column="2" ItemsSource="{Binding ExplorerEntries}" SelectedItem="{Binding SelectedExplorerEntry}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="OpenExplorerFolder">
      <DataGrid.Columns>
       <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_File}" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_ExplorerTitle}" Binding="{Binding Title}" Width="2*"/>
       <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.CnmtOverview_TitleId}" Binding="{Binding TitleId}" Width="150"/>
       <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Nand_ExplorerUserId}" Binding="{Binding UserId}" Width="240"/>
       <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.BatchIntegrity_FileType}" Binding="{Binding Type}" Width="120"/>
       <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.FileInfo_FileSize}" Binding="{Binding Size, StringFormat={}{0:N0} B}" Width="120"/>
      </DataGrid.Columns>
     </DataGrid>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
