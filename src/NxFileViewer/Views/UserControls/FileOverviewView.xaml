<UserControl x:Class="Emignatik.NxFileViewer.Views.UserControls.FileOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization"
             xmlns:customControls="clr-namespace:Emignatik.NxFileViewer.Views.CustomControls"
             xmlns:userControls="clr-namespace:Emignatik.NxFileViewer.Views.UserControls"
             mc:Ignorable="d" 
             Style="{StaticResource UserControlStyle}"
             d:DesignHeight="450" d:DesignWidth="400" d:DataContext="{d:DesignInstance userControls:FileOverviewViewModel}">

    <UserControl.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="620"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="580"/></DataTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource FontBrush.Error}" BorderThickness="1" Padding="10" Margin="4,4,4,8"
                Visibility="{Binding IsMissingKeysWarningVisible, Converter={StaticResource FalseToCollapseVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding DismissMissingKeysWarningCommand}"
                            ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Close}"
                            AutomationProperties.Name="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.MenuItem_Close}"
                            Width="26" Height="26" Margin="8,0,0,0" Padding="0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.File_MissingKeys}" Foreground="{DynamicResource FontBrush.Error}" FontWeight="Bold" TextWrapping="Wrap"/>
                </DockPanel>
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding MissingKeys}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </ScrollViewer>
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.File_CopyMissingKeys}" Command="{Binding CopyMissingKeysCommand}" HorizontalAlignment="Left" Padding="10,3" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <GroupBox Grid.Row="1" Grid.Column="0" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.FileInfo_Title}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch">
                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Title_FileInfo_FileType}" Margin="0,1,2,0" />
                    <TextBox Text="{Binding Path=FileType, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}" MinWidth="80"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Stretch" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.ToolTip_PackageStructure}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.PackageStructure_Title}" Margin="0,1,2,0"/><customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.ToolTip_PackageStructure}"/></StackPanel>
                    <TextBox Text="{Binding Path=PackageStructure, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}" MinWidth="70"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Stretch">
                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Title_FileInfo_Compression}" Margin="0,1,2,0" />
                    <TextBox Text="{Binding Path=CompressionType, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}" MinWidth="60"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="6" Orientation="Vertical" HorizontalAlignment="Stretch">
                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Title_FileInfo_Integrity}" Margin="0,1,2,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" MinWidth="80" Style="{StaticResource ReadOnlyTextBox}" Text="{Binding Path=NcasIntegrity, Mode=OneWay, Converter={StaticResource NcasIntegrityConverter}}"
                                 Foreground="{Binding NcasIntegrityValidityColor}" HorizontalAlignment="Stretch" />
                        <customControls:PlayStopButton Grid.Column="1" Width="16" Height="16" Margin="2,0,0,0" Command="{Binding Path=VerifyNcasIntegrityCommand}" />
                        <customControls:TipLabel Grid.Column="2" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.ToolTip_NcasIntegrity}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.FileInfo_FileSize}" />
                    <TextBox Text="{Binding Path=FileSize, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.ToolTip_NcaSignature}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Signature_Title}"/><customControls:TipLabel ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.ToolTip_NcaSignature}"/></StackPanel>
                    <TextBox Text="{Binding NcaSignature, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
                </StackPanel>                <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.FileInfo_CompressionRatio}" />
                    <TextBox Text="{Binding Path=CompressionRatio, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                            Visibility="{Binding Path=SystemUpdateVisibility, Mode=OneWay}">
                    <TextBlock Style="{StaticResource Title2}" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.FileInfo_SystemUpdate}" />
                    <TextBox Text="{Binding Path=SystemUpdateVersion, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Homebrew (NRO)" Visibility="{Binding IsHomebrew, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                <Image Source="{Binding HomebrewTitle.Icon}" Width="160" Height="160" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal"><Button Command="{Binding SaveHomebrewImageCommand}" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.ContextMenu_SaveImage}"/><Button Command="{Binding CopyHomebrewImageCommand}" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.ContextMenu_CopyImage}"/></StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.AppTitle}"/>
                <TextBox Text="{Binding HomebrewTitle.AppName, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Publisher}"/>
                <TextBox Text="{Binding HomebrewTitle.Publisher, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.DisplayVersion}"/>
                <TextBox Text="{Binding HomebrewVersion, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.AvailableLanguages}"/>
                <TextBox Text="{Binding HomebrewLanguages, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
                <TextBlock Text="Build ID"/><TextBox Text="{Binding HomebrewBuildId, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
            </StackPanel></ScrollViewer>
        </GroupBox>
        <customControls:MaskableGroupBox Grid.Row="2" Grid.Column="0" Visibility="{Binding HasPackageDetails, Converter={StaticResource FalseToCollapseVisibilityConverter}}" Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Packages_Title}" IsMasked="{Binding Path=IsSuperPackage, Converter={StaticResource BoolInverterConverter}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Visibility="{Binding Path=IsSuperPackage, Converter={StaticResource FalseToCollapseVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource Title2}"
                               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.AvailableContents}" 
                               HorizontalAlignment="Right" Margin="0,0,2,0" VerticalAlignment="Center" />

                    <ComboBox Grid.Column="1" HorizontalAlignment="Center" MinWidth="100" VerticalAlignment="Center"
                              ItemsSource="{Binding Path=CnmtContainers}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Path=SelectedCnmtContainer}" />

                    <customControls:TipLabel Grid.Column="2" ToolTip="{Binding Path=MultiContentPackageToolTip}" HorizontalAlignment="Left"/>

                </Grid>

                <userControls:CnmtContainerView Grid.Row="1" DataContext="{Binding Path=SelectedCnmtContainer}" />
                <TextBox Grid.Row="2" MaxHeight="160" Text="{Binding InstalledTitlesWithoutMeta, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding HasInstalledTitlesWithoutMeta, Converter={StaticResource FalseToCollapseVisibilityConverter}}"/>

            </Grid>
        </customControls:MaskableGroupBox>
    </Grid>

</UserControl>
