<UserControl x:Class="Emignatik.NxFileViewer.Views.UserControls.CreditsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Emignatik.NxFileViewer.Localization">
    <StackPanel Margin="0,16,0,0">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Info_Credits}"
                   Style="{StaticResource Title2}" Margin="0,0,0,12"/>
        <TextBox x:Name="CreditsText" IsReadOnly="True" TextWrapping="Wrap"
                 BorderThickness="0" Background="Transparent" Padding="0"
                 HorizontalAlignment="Stretch"/>
        <Expander Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Current.Keys.Info_Licenses}" Margin="0,12,0,0">
            <TextBox x:Name="LicensesText" IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="360" VerticalScrollBarVisibility="Auto"
                     Background="Transparent" BorderThickness="0" Padding="8"/>
        </Expander>
    </StackPanel>
</UserControl>