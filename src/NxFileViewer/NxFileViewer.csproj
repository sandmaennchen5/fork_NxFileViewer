<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>4.1.2-beta4</Version>
    <ExplorerPackageVersion>1.0.5.0</ExplorerPackageVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>NxFileViewerFork</AssemblyName>
    <AssemblyTitle>NxFileViewer Fork</AssemblyTitle>
    <Product>NxFileViewer Fork</Product>
    <RootNamespace>NxFileViewer.Avalonia</RootNamespace>
    <ApplicationIcon>Shared/Styling/Icons/Icon.ico</ApplicationIcon>
    <!-- Preserve the reflection bindings used by the converted views. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NxFileViewer.Test" />
    <EmbeddedResource Include="Shared/Services/FileAssociations/Launcher/NxFileViewerFork.Open.exe" LogicalName="Viewer.AssociationLauncher" />
    <EmbeddedResource Include="../NxFileViewer.Explorer/Native/x64/NxFileViewer.Explorer.dll" LogicalName="Viewer.Explorer.x64" />
    <EmbeddedResource Include="../NxFileViewer.Explorer/Native/x86/NxFileViewer.Explorer.dll" LogicalName="Viewer.Explorer.x86" />
    <EmbeddedResource Include="../NxFileViewer.Explorer/Native/arm64/NxFileViewer.Explorer.dll" LogicalName="Viewer.Explorer.arm64" />
    <EmbeddedResource Include="../NxFileViewer.Explorer/Trust-ExplorerCertificate.ps1" LogicalName="Viewer.Explorer.Trust.ps1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="LibHac" Version="0.19.0" />
    <PackageReference Include="SharpCompress" Version="0.50.11" />
    <ProjectReference Include="../LibHac.NSZ/LibHac.NSZ.csproj" />
    <EmbeddedResource Include="../config/master-keys.json" LogicalName="Viewer.MasterKeys.json" />
    <EmbeddedResource Include="../Resources/nxfv-xci.png" LogicalName="Viewer.LinuxLauncherIcon" />
    <AvaloniaResource Include="Shared/Styling/Icons/*.*" Link="Icons/%(Filename)%(Extension)" />
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Shared/Styling/Theme/WorkspaceIcons.xaml" LogicalName="Viewer.WorkspaceIcons" />
    <EmbeddedResource Include="../config/naming-presets.json" LogicalName="Viewer.NamingPresets.json" />
    <EmbeddedResource Include="../config/default-settings.json" LogicalName="Viewer.DefaultSettings.json" />
    <EmbeddedResource Include="../config/external-sources.json" LogicalName="Viewer.ExternalSources.json" />
    <EmbeddedResource Include="../config/package-manifest.json" LogicalName="Viewer.PackageManifest.json" />
    <AssemblyMetadata Include="ViewerSingleFile" Value="$(PublishSingleFile)" />
    <AssemblyMetadata Include="ViewerSelfContained" Value="$(SelfContained)" />
    <EmbeddedResource Include="Shared/Styling/Theme/LightTheme.xaml" LogicalName="Viewer.Theme.Light" />
    <EmbeddedResource Include="Shared/Styling/Theme/DarkTheme.xaml" LogicalName="Viewer.Theme.Dark" />
    <EmbeddedResource Include="../../CREDITS.txt" LogicalName="Viewer.Credits" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Viewer.License" />
    <EmbeddedResource Include="../../docs/THIRD-PARTY-NOTICES.txt" LogicalName="Viewer.ThirdPartyNotices" />
    <Content Include="../../fw/hashes/*.json" Link="Plugins/fwhashes/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
