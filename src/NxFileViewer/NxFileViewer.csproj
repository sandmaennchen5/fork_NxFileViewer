<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Emignatik.NxFileViewer</RootNamespace>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Styling\Icons\Icon.ico</ApplicationIcon>
    <AssemblyName>NxFileViewerFork</AssemblyName>
    <PackageId>NxFileViewerFork</PackageId>
    <Company>sandmaennchen5</Company>
    <Product>NxFileViewer Fork</Product>
    <Authors>sandmaennchen5</Authors>
    <Version>4.1.1-beta1</Version>
    <!-- Increment when the packaged Explorer extension changes. -->
    <ExplorerPackageVersion>1.0.4.0</ExplorerPackageVersion>
    <PackageProjectUrl>https://github.com/sandmaennchen5/fork_NxFileViewer</PackageProjectUrl>
    <PackageIcon>Icon.ico</PackageIcon>
    <Description>Browse content of Nintendo Switch files</Description>
    <RepositoryUrl>https://github.com/sandmaennchen5/fork_NxFileViewer</RepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Styling\Icons\close_16x16.png" />
    <None Remove="Styling\Icons\CnmtContentEntryItem.png" />
    <None Remove="Styling\Icons\exit_16x16.png" />
    <None Remove="Styling\Icons\FileDirectoryEntryItem.png" />
    <None Remove="Styling\Icons\FolderDirectoryEntryItem.png" />
    <None Remove="Styling\Icons\Icon.ico" />
    <None Remove="Styling\Icons\navigate_16x16.png" />
    <None Remove="Styling\Icons\NspItem.png" />
    <None Remove="Styling\Icons\open_16x16.png" />
    <None Remove="Styling\Icons\PartitionFileEntryItem.png" />
    <None Remove="Styling\Icons\refresh_16x16.png" />
    <None Remove="Styling\Icons\reload_last_16x16.png" />
    <None Remove="Styling\Icons\rename_16x16.png" />
    <None Remove="Styling\Icons\safe_16x16.png" />
    <None Remove="Styling\Icons\SectionItem.png" />
    <None Remove="Styling\Icons\settings_16x16.png" />
    <None Remove="Styling\Icons\XciItem.png" />
    <None Remove="Styling\Icons\XciPartitionItem.png" />
    <None Include="Styling\Icons\Icon.ico">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibHac" Version="0.19.0" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="SharpCompress" Version="0.50.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibHac.NSZ\LibHac.NSZ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Styling\Icons\close_16x16.png" />
    <Resource Include="Styling\Icons\CnmtContentEntryItem.png" />
    <Resource Include="Styling\Icons\exit_16x16.png" />
    <Resource Include="Styling\Icons\FileDirectoryEntryItem.png" />
    <Resource Include="Styling\Icons\FolderDirectoryEntryItem.png" />
    <Resource Include="Styling\Icons\Icon.ico" />
    <Resource Include="Styling\Icons\navigate_16x16.png" />
    <Resource Include="Styling\Icons\NspItem.png" />
    <Resource Include="Styling\Icons\open_16x16.png" />
    <Resource Include="Styling\Icons\PartitionFileEntryItem.png" />
    <Resource Include="Styling\Icons\refresh_16x16.png" />
    <Resource Include="Styling\Icons\reload_last_16x16.png" />
    <Resource Include="Styling\Icons\rename_16x16.png" />
    <Resource Include="Styling\Icons\safe_16x16.png" />
    <Resource Include="Styling\Icons\settings_16x16.png" />
    <Resource Include="Styling\Icons\XciPartitionItem.png" />
    <Resource Include="Styling\Icons\SectionItem.png" />
    <Resource Include="Styling\Icons\XciItem.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\UserControls\FileOverviewView.xaml.cs">
      <DependentUpon>FileOverviewView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Styling\TextBlockStyle.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Styling\CheckBoxStyle.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
    <Page Update="Views\UserControls\FileOverviewView.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Windows\SettingsWindow.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\fw\hashes\*.json" Link="Plugins\fwhashes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Services\FileAssociations\Launcher\NxFileViewerFork.Open.exe" LogicalName="Viewer.AssociationLauncher" />
    <EmbeddedResource Include="..\NxFileViewer.Explorer\Native\x64\NxFileViewer.Explorer.dll" LogicalName="Viewer.Explorer.x64" />
    <EmbeddedResource Include="..\NxFileViewer.Explorer\Native\x86\NxFileViewer.Explorer.dll" LogicalName="Viewer.Explorer.x86" />
    <EmbeddedResource Include="..\NxFileViewer.Explorer\Native\arm64\NxFileViewer.Explorer.dll" LogicalName="Viewer.Explorer.arm64" />
    <EmbeddedResource Include="..\NxFileViewer.Explorer\Trust-ExplorerCertificate.ps1" LogicalName="Viewer.Explorer.Trust.ps1" />
    <EmbeddedResource Include="Services\Updates\InstallUpdate.ps1" LogicalName="ViewerUpdate.InstallUpdate.ps1" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ViewerSelfContained" Value="$(SelfContained)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../config/default-settings.json" LogicalName="Viewer.DefaultSettings.json" />
    <EmbeddedResource Include="../config/master-keys.json" LogicalName="Viewer.MasterKeys.json" />
    <EmbeddedResource Include="../config/naming-presets.json" LogicalName="Viewer.NamingPresets.json" />
    <EmbeddedResource Include="../config/external-sources.json" LogicalName="Viewer.ExternalSources.json" />
    <EmbeddedResource Include="../../CREDITS.txt" LogicalName="Viewer.Credits" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Viewer.License" />
    <EmbeddedResource Include="../../docs/THIRD-PARTY-NOTICES.txt" LogicalName="Viewer.ThirdPartyNotices" />
    <EmbeddedResource Include="../../docs/Icon-provenance.md" LogicalName="Viewer.IconProvenance" />
    <None Include="../../docs/Icon-provenance.md" Link="Icon-provenance.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
    <None Include="../../CREDITS.txt" Link="CREDITS.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../../docs/THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
    <None Include="../../docs/licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
