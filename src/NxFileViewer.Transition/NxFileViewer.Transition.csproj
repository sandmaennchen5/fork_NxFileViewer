<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaVersion>12.2.0</AvaloniaVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>NxFileViewer</AssemblyName>
    <RootNamespace>NxFileViewer.Transition</RootNamespace>
    <Version>4.1.2-beta3</Version>
    <Product>NxFileViewer Fork</Product>
    <Authors>sandmaennchen5</Authors>
    <RepositoryUrl>https://github.com/sandmaennchen5/fork_NxFileViewer</RepositoryUrl>
    <ApplicationIcon>../NxFileViewer/Shared/Styling/Icons/Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <Compile Include="../NxFileViewer/Shared/Services/Updates/ViewerUpdateService.cs" Link="ViewerUpdateService.cs" />
    <Compile Include="../NxFileViewer/Shared/Services/Updates/ViewerPackageLayout.cs" Link="ViewerPackageLayout.cs" />
    <Compile Include="../NxFileViewer/Shared/Services/Updates/ViewerVersion.cs" Link="ViewerVersion.cs" />
    <Compile Include="../NxFileViewer/Shared/Services/Updates/ViewerUpdateMetadata.cs" Link="ViewerUpdateMetadata.cs" />
    <Compile Include="../NxFileViewer/Shared/Services/Updates/ViewerUpdateSource.cs" Link="ViewerUpdateSource.cs" />
    <Compile Include="../NxFileViewer/Shared/Services/Updates/ViewerRemoteReleaseSource.cs" Link="ViewerRemoteReleaseSource.cs" />
    <EmbeddedResource Include="InstallUpdate.ps1" LogicalName="ViewerUpdate.InstallUpdate.ps1" />
    <AssemblyMetadata Include="ViewerSelfContained" Value="$(SelfContained)" />
  </ItemGroup>
</Project>
