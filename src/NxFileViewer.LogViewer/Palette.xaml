<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <SolidColorBrush x:Key="InfoBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#92400E"/>
        <SolidColorBrush x:Key="WarningBackground" Color="#FFF4CC"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="ErrorBackground" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

</ResourceDictionary>
