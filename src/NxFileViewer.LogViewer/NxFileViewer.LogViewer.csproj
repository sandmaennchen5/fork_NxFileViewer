<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>NxFileViewerFork.LogViewer</AssemblyName>
    <RootNamespace>NxFileViewer.LogViewer</RootNamespace>
    <Version>4.1.0-beta1</Version>
    <Product>NxFileViewer Fork LogViewer</Product>
    <Authors>sandmaennchen5</Authors>
    <ApplicationIcon>../NxFileViewer/Styling/Icons/Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../NxFileViewer/Styling/Icons/Icon.ico" Link="Icon.ico" />
    <None Include="../../docs/LogViewer.md" Link="LogViewer.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
