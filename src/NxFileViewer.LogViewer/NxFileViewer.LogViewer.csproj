<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>4.1.2-beta3</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>NxFileViewerFork.LogViewer</AssemblyName>
    <RootNamespace>NxFileViewer.LogViewer</RootNamespace>
    <ApplicationIcon>../NxFileViewer/Shared/Styling/Icons/Icon.ico</ApplicationIcon>
    <!-- Preserve the reflection bindings used by the converted views. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaVersion>12.2.0</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <InternalsVisibleTo Include="NxFileViewer.Test" />
    <AvaloniaResource Include="../NxFileViewer/Shared/Styling/Icons/Icon.ico" Link="Icon.ico" />
    <None Include="../../docs/LogViewer.md" Link="LogViewer.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Palette.xaml" LogicalName="LogViewer.Palette" />
  </ItemGroup>
</Project>
