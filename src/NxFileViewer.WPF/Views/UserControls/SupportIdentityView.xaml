<UserControl x:Class="Emignatik.NxFileViewer.Views.UserControls.SupportIdentityView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="0,0,0,12">
  <Label x:Name="IdentityLabel" Target="{Binding ElementName=IdentityText}"/>
  <TextBox x:Name="IdentityText" IsReadOnly="True"/>
  <WrapPanel Margin="0,6,0,0">
   <Button x:Name="CopyButton" Click="Copy_Click" IsEnabled="False" Padding="8,4" Margin="0,0,8,0"/>
   <Button x:Name="SearchButton" Click="Search_Click" IsEnabled="False" Padding="8,4"/>
  </WrapPanel>
  <TextBlock x:Name="IdentityStatus" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
